{
  "schema": "luminous.rust-pgo-evidence-passport.v0.1",
  "status": "research_protocol_not_yet_qualified",
  "toolchain": {
    "rustc": "1.100.0",
    "cargo": "1.100.0",
    "llvm_major_must_match": true
  },
  "methods": [
    {
      "id": "instrumentation-pgo",
      "generate_flag": "-Cprofile-generate",
      "consume_flag": "-Cprofile-use",
      "converter": "llvm-profdata",
      "training_example": "jphi_convergence",
      "transfer_probes": [
        "gradient_replacement",
        "cooperation_decomposition"
      ]
    },
    {
      "id": "instrumentation-pgo-same-program-seed-holdout",
      "profile_generation": "instrumentation PGO on one selected example",
      "profile_consumption_flag": "-Cprofile-use",
      "same_program_training_and_holdout": true,
      "default_training_logical_indices": "0..9",
      "default_holdout_logical_indices": "10..19",
      "seed_formula": "42 + 997 * logical_index",
      "train_and_holdout_disjoint": true,
      "profile_collection_scope": "training indices only",
      "runtime_measurement_scope": "held-out indices only",
      "exact_training_output_equivalence": true,
      "exact_heldout_stdout_and_stderr_equivalence": true,
      "target_example_options": [
        "jphi_convergence",
        "gradient_replacement",
        "cooperation_decomposition"
      ]
    },
    {
      "id": "sample-pgo",
      "generate_method": "perf branch-stack sampling + llvm-profgen",
      "consume_flag": "-Cprofile-sample-use",
      "training_example": "jphi_convergence",
      "platform": "x86_64-unknown-linux-gnu",
      "pmu_required": true
    }
  ],
  "immutable_bindings": [
    "git_commit",
    "git_tree",
    "Cargo.lock sha256",
    "rustc -Vv",
    "cargo -Vv",
    "LLVM version",
    "target triple",
    "RUSTFLAGS",
    "Cargo features",
    "training workload identifiers",
    "experiment seed schedule",
    "profile sha256",
    "logical training seed-index set",
    "logical held-out seed-index set",
    "mapped deterministic seed values",
    "same-program experiment target identity",
    "training and holdout disjointness receipt"
  ],
  "proposed_acceptance": {
    "median_runtime_improvement_training_min_percent": 5,
    "median_runtime_improvement_transfer_min_percent": 3,
    "max_critical_workload_regression_percent": 2,
    "max_binary_size_growth_percent": 5,
    "max_peak_rss_growth_percent": 5,
    "paired_runs_exploratory_min": 5,
    "paired_runs_claim_min": 30,
    "p99_observations_per_condition_min": 10000,
    "exact_stdout_equivalence_required": true,
    "no_scientific_inputs_may_change": true
  },
  "claim_ceiling": [
    "PASS_MECHANICAL_PROFILE_AND_OUTPUT_CHECKS does not establish a speedup",
    "cross-example transfer is not an IID held-out split",
    "PMU unavailability is NOT_EVALUABLE, not PASS or FAIL for compiler compatibility",
    "sample and instrumentation profiles are not interchangeable",
    "Runtime repeats nested inside one build trial do not increase the count of independent compiler/build trials",
    "same-program seed holdout is a within-example disjoint-seed validation, not cross-example or physical-world generalization",
    "PASS_MECHANICAL_PROFILE_AND_HELDOUT_OUTPUT_CHECKS does not establish a speedup"
  ],
  "experiment_design": {
    "build_repeats_default": 5,
    "runtime_repeats_per_build_default": 5,
    "build_trial_is_fresh_target_directory": true,
    "rotate_build_and_runtime_order": true,
    "match_debug_info_flags_between_variants": true,
    "measure_compile_time_and_peak_rss_per_build_trial": true,
    "nested_runtime_repeats_are_not_independent_build_trials": true,
    "same_program_seed_holdout": {
      "enabled_by_explicit_workflow_dispatch": true,
      "preserves_historical_default_seed_schedule": true,
      "default_seed_formula": "42 + 997 * logical_index",
      "default_training_indices": "0..9",
      "default_holdout_indices": "10..19",
      "rejects_train_holdout_overlap": true,
      "requires_training_output_match_between_instrumented_and_no_pgo": true,
      "requires_heldout_stdout_and_stderr_match": true,
      "repeats_heldout_execution_within_each_fresh_build_trial": true,
      "runtime_timer_excludes_hashing_and_receipt_generation": true
    }
  },
  "evidence_integrity": {
    "run_manifest": "metadata/run-manifest.txt",
    "evidence_file_list": "evidence-files.sha256",
    "integrity_manifest": "integrity-manifest.txt",
    "verifier": "scripts/verify-rust-pgo-evidence.sh",
    "verify_source_commit_and_tree": true,
    "verify_cargo_lock_before_after": true,
    "verify_every_retained_file_sha256": true,
    "verify_exact_local_toolchain_when_available": true,
    "claim": "PASS_EVIDENCE_INTEGRITY_ONLY",
    "exclusions": [
      "not a signature",
      "not host attestation",
      "not evidence of physical authenticity",
      "not a scientific correctness proof",
      "not a performance improvement claim"
    ]
  }
}
