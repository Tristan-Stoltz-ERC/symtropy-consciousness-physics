{
  "schema":"luminous.symtropy.event-lineage-rng.v0.1",
  "status":"additive_hierarchical_identity_prototype",
  "algorithm":"philox4x64-10-lineage-128-v1",
  "identity":{
    "root":["experiment_namespace_u64","stable_subject_id_u64","root_domain","schema_version"],
    "child":["parent_lineage_id_u128","event_kind_u16","draw_purpose_u16","semantic_occurrence_u32","child_domain"],
    "width_bits":128,
    "replicate_seed_in_identity":false,
    "scenario_treatment_or_branch_in_identity":false,
    "execution_order_thread_or_wall_clock_in_identity":false
  },
  "random_address":{
    "key":["replicate_seed_u64","experiment_namespace_u64"],
    "counter":["lineage_id_word_0","lineage_id_word_1","simulation_tick_u64","block_index_u64"]
  },
  "collision_policy":{
    "non_cryptographic":true,
    "semantic_path_retained":true,
    "distinct_path_collision_rejected_by_registry":true
  },
  "tests":[
    "schema_v1_root_child_known_answer",
    "sibling_order_independence",
    "parent_role_occurrence_sensitivity",
    "shared_vs_conditional_identity",
    "replicate_key_separation",
    "open_uniform_bounds",
    "registry_idempotence",
    "forced_collision_negative_control"
  ],
  "nonclaims":[
    "not_collision_free",
    "not_integrated_into_simulation_call_sites",
    "no_statistical_battery_claim",
    "no_physical_model_causal_validity_claim",
    "no_gpu_cross_language_identity_claim",
    "no_performance_claim"
  ]
}