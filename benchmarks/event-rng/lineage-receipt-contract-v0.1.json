{
  "schema":"luminous.dynamic-entity-lineage-receipt.v1",
  "status":"canonical_export_validation_and_scenario_reconciliation",
  "encoding":{
    "format":"strict_utf8_line_records",
    "header":"fixed_schema_and_record_count",
    "rows_sorted_by":"ascending_subject_id",
    "parent_ids":"ascending_decimal_colon_separated_or_hyphen_for_empty",
    "semantic_birth_event_id":"32_lowercase_hex_digits",
    "numeric_encoding":"canonical_decimal",
    "single_logical_receipt_single_byte_representation":true
  },
  "validation":{
    "rederive_subject_id_from_birth_key":true,
    "reserve_static_subject_ids":true,
    "reject_duplicate_birth_keys":true,
    "reject_duplicate_subject_ids":true,
    "reject_noncanonical_encoding":true
  },
  "reconciliation":{
    "match_key":"complete_birth_key",
    "merge_registries_across_scenarios":true,
    "report":["matched_births","reference_only_births","counterfactual_only_births"],
    "equal_subject_id_alone_is_not_match":true
  },
  "tests":[
    "canonical_roundtrip",
    "insertion_order_invariance",
    "noncanonical_rows_rejected",
    "tampered_subject_id_rejected",
    "static_collision_rejected",
    "shared_and_conditional_birth_counts",
    "distinct_births_not_matched_by_id",
    "duplicate_assignment_rejected",
    "parentless_birth_roundtrip"
  ],
  "nonclaims":[
    "no_birth_parentage_scientific_validity_claim",
    "no_authentication_or_signature",
    "no_distributed_consensus",
    "no_live_symtropy_birth_site_migration"
  ]
}