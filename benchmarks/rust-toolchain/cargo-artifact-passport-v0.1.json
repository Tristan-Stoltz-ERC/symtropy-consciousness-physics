    "git_tree",
    "manifest_sha256",
    "cargo_lock_sha256"
  ],
  "toolchain_identity": [
    "rustc_verbose_version",
    "rustc_commit_hash",
    "cargo_verbose_version",
    "target_triple"
  ],
  "artifact_identity": [
    "package_id",
    "target",
    "profile",
    "cargo_reported_root_target_or_build",
    "relative_path_under_reported_root",
    "sha256",
    "size_bytes"
  ],
  "integrity_verifier": [
    "passport_sha256",
    "raw_cargo_messages_sha256",
    "cargo_metadata_sha256",
    "compiler_artifact_manifest_sha256",
    "each_artifact_sha256_and_size",
    "source_git_identity",
